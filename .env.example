# Скопируйте этот файл в .env и укажите значения ниже.
# Не публикуйте .env: в нём будут секретный токен и пароль базы данных.

# Токен Telegram-бота от @BotFather. Получите его командой /newbot.
# Формат обычно: 123456789:ABC...; вставьте токен целиком после знака =.
BOT_TOKEN=

# Адрес подключения приложения к PostgreSQL.
# Пароль в адресе должен совпадать с POSTGRES_PASSWORD ниже.
DATABASE_URL=postgresql://moydodyr:moydodirqwerty@localhost:5432/moydodyr

# Числовой ID Telegram-группы, куда бот отправляет заявки.
# Добавьте бота в эту группу; ID обычно отрицательный. Укажите число, не @username.
MANAGER_CHAT_ID=

# Числовые Telegram ID администраторов бота через запятую.
# Они смогут брать заявки и менять настройки командами /admin.
# Пример формата: 123456789,987654321
ADMIN_IDS=

# Уровень сообщений в журнале: DEBUG, INFO, WARNING или ERROR.
LOG_LEVEL=INFO

# Пароль пользователя moydodyr в локальном PostgreSQL-контейнере.
# Задайте длинный случайный пароль и укажите его также в DATABASE_URL.
POSTGRES_PASSWORD=<задайте-длинный-случайный-пароль>

# URL входящего webhook в n8n; должен начинаться с https://.
N8N_WEBHOOK_URL=https://moydodyr.app.n8n.cloud/webhook/moydodyr-lead

# Секрет для проверки webhook. Укажите его только в локальном .env.
N8N_WEBHOOK_SECRET=
